# ============================================================
#  send_of_v4 — configuração para WINDOWS NATIVO + Firefox local
#  Copie este arquivo para .env e ajuste os caminhos se necessário.
# ============================================================

SECRET_KEY=django-insecure-sendof-windows-local-troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Banco local (SQLite na raiz do projeto).
DATABASE_URL=sqlite:///db.sqlite3
# Para usar o PostgreSQL local do projeto (criado por
# scripts/postgres_local_windows.ps1), troque por:
# DATABASE_URL=postgres://send_of:send_of@127.0.0.1:5433/sccj

# Celery/Redis desligados no uso local
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# E-mail em modo console (não envia de verdade)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------------------------------
# Firefox local / Projudi
# ------------------------------------------------------------------
# Deixe vazio para detectar automaticamente pelo registro do Windows.
FIREFOX_PATH=C:\Program Files\Mozilla Firefox\firefox.exe
# Deixe vazio para usar o perfil mais recente de %APPDATA%\Mozilla\Firefox.
FIREFOX_PROFILE=
# Deixe vazio para gravar em %LOCALAPPDATA%\send_of_v4\cookies.json
PROJUDI_COOKIES_FILE=
PROJUDI_DOMAIN=projudi.tjba.jus.br

# Automação: 0 = Firefox visível, 1 = sem janela
PLAYWRIGHT_HEADLESS=0
# Normalmente vazio: usa o Firefox próprio do Playwright (instalado por
# "python -m playwright install firefox").
PLAYWRIGHT_FIREFOX_EXECUTABLE=

# ------------------------------------------------------------------
# IA / Google (opcionais)
# ------------------------------------------------------------------
OPENAI_API_KEY=
QWEN_MODEL_PATH=
QWEN_SERVER_URL=http://localhost:8080

GOOGLE_SERVICE_ACCOUNT_FILE=
# Aceita o ID puro ou o link completo do Google Docs:
GOOGLE_OFICIOS_DOC_URL=
GOOGLE_OFICIOS_DOC_ID=1dY6yODJF0CFdbWZ2tH2f-cfvfyqq6RuKUo92NJE7JrY
GOOGLE_OFICIOS_TABLE_INDEX=0
# Apps Script (recomendado quando o documento é compartilhado com "qualquer pessoa"):
GOOGLE_OFICIOS_WEBHOOK_URL=
GOOGLE_OFICIOS_WEBHOOK_TOKEN=
