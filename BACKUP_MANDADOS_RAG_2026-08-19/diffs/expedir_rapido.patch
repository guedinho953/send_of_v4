+def _limpar_endereco(endereco: str) -> str:
+    """Limpa e formata o endereço da parte p/ o mandado.
+
+    Remove vírgulas com segmentos vazios, tags <br>, sufixos '- BA'/'- BRASIL',
+    o bloco 'CEP xxxxx-xxx' (vira linha própria), e pontuação residual.
+    Ex:
+      'RUA Campo Grande, , 113, , APTO SANDES CONSTRUCOES, , Perpétuo Socorro, '
+      ', , , , PAULO AFONSO, , , , , , - BA, , , , , - BRASIL, , , , <br>CEP 48603-190'
+      -> 'Rua Campo Grande, 113 - Apto Sandes Construcoes - Perpetuo Socorro - '
+         'Paulo Afonso/BA<br>CEP 48603-190'
+    """
+    if not endereco:
+        return ''
+    import re
+    t = str(endereco)
+    # remove tags
+    t = re.sub(r'<[^>]+>', ' | ', t)
+    # extrai CEP
+    cep = ''
+    m = re.search(r'\bCEP\s*([\d-]+)', t, re.I)
+    if m:
+        cep = m.group(1)
+        t = t.replace(m.group(0), '')
+    # remove sufixos de país/estado soltos
+    t = re.sub(r'\s*-\s*(?:BA|BRASIL)\b', '', t, flags=re.I)
+    # quebra por vírgula e descarta vazios
+    partes = []
+    for seg in t.split(','):
+        seg = re.sub(r'\s*[|]\s*', ' ', seg).strip()
+        seg = re.sub(r'\s{2,}', ' ', seg).strip()
+        # remove ' -' / '-' residual, pontuação solta
+        seg = seg.strip(' -').strip()
+        if seg and seg.lower() not in ('ba', 'brasil'):
+            partes.append(seg)
+    txt = ' - '.join(partes)
+    txt = re.sub(r'\s{2,}', ' ', txt).strip(' -')
+    if cep:
+        txt = txt + ('<br>CEP %s' % cep) if not txt.endswith('CEP') else txt
+    return txt
+
+
