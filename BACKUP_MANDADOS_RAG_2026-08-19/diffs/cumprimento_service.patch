+    @staticmethod
+    def _rotulo_meio(fluxo: str, djen: bool, modo: str) -> str:
+        """Meio curto da intimação p/ o texto da observação (DJEN / e-mail /
+        AR / advogado / edital / mandado / intimação)."""
+        if modo == 'decadencial':
+            return 'intimação'
+        if djen or fluxo == 'eletronico':
+            return 'DJEN'
+        return {
+            'ar': 'AR',
+            'email': 'e-mail',
+            'email_condicional': 'e-mail',
+            'advogado': 'advogado(a)',
+            'edital': 'edital',
+            'mandado': 'mandado',
+            'movimentacao_simples': 'intimação',
+        }.get(fluxo, 'intimação')
+
+    @staticmethod
+    def _capitalizar_nome_proprio(nome: str) -> str:
+        """Capitaliza o nome do servidor preservando preposições minúsculas.
+
+        'ivan guedes da silva'  -> 'Ivan Guedes da Silva'
+        'MARIA JOSE DE SOUZA'   -> 'Maria Jose de Souza'
+        """
+        if not nome:
+            return nome
+        prepos = {'de', 'da', 'do', 'das', 'dos', 'e'}
+        partes = []
+        for i, w in enumerate(str(nome).strip().split()):
+            lw = w.lower()
+            if i > 0 and lw in prepos:
+                partes.append(lw)
+            elif w:
+                partes.append(w[:1].upper() + w[1:].lower())
+        return ' '.join(partes)
+
